<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openpatch</groupId>
        <artifactId>scratch-parent</artifactId>
        <version>6.5.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- Maps from the Tiled editor (TMX and TMJ), drawn through a layer drawer.
         Uses only the core's public API (checked by all/src/build/BuildChecks.java). -->
    <artifactId>scratch-tiled</artifactId>
    <packaging>jar</packaging>
    <name>Scratch for Java: Tiled maps</name>

    <dependencies>
        <dependency>
            <groupId>org.openpatch</groupId>
            <artifactId>scratch</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- the tests (not the extension) run a headless game and read its
                                 draw list, which the core does not export -->
                            <compilerArgs>
                                <arg>--add-exports</arg>
                                <arg>org.openpatch.scratch/org.openpatch.scratch.internal=org.openpatch.scratch.tiled</arg>
                                <arg>--add-exports</arg>
                                <arg>org.openpatch.scratch/org.openpatch.scratch.internal.draw=org.openpatch.scratch.tiled</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

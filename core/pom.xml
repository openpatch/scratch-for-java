<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openpatch</groupId>
        <artifactId>scratch-parent</artifactId>
        <version>7.0.0</version>
    </parent>

    <!-- The core library: stage, sprites, text, sound, shaders; platform-neutral. -->
    <artifactId>scratch</artifactId>
    <packaging>jar</packaging>
    <name>Scratch for Java</name>

    <!-- No dependencies: the window, OpenGL, sound and decoders come from a platform module
         (scratch-desktop: LWJGL; scratch-web: the browser), see internal/platform/Platform. -->
    <dependencies>
        <!-- tests only: the test platform decodes images and Ogg files with stb, as the desktop does -->
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-linux</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-linux-arm64</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-macos</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-macos-arm64</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-windows</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><classifier>natives-windows-arm64</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-linux</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-linux-arm64</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-macos</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-macos-arm64</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-windows</classifier><scope>test</scope></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><classifier>natives-windows-arm64</classifier><scope>test</scope></dependency>
    </dependencies>

    <properties>
        <!-- the nrw profile compiles a rewritten copy instead (src/build/NrwVariant.java) -->
        <scratch.sourceDirectory>src/main/java</scratch.sourceDirectory>
    </properties>

    <profiles>
        <!--
            The NRW build: find, getAll and getTouchingSprites return the List of the NRW
            Zentralabitur instead of java.util.List. The sources are rewritten from the
            `// nrw-standard-begin` / `// nrw:` markers in Stage and Sprite and compiled instead.
                mvn clean package -Pnrw   ->  all/target/scratch-<version>-nrw-all.jar
        -->
        <profile>
            <id>nrw</id>
            <properties>
                <scratch.sourceDirectory>${project.build.directory}/nrw-sources</scratch.sourceDirectory>
                <maven.test.skip>true</maven.test.skip>
                <maven.javadoc.skip>true</maven.javadoc.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-nrw-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>src/build/NrwVariant.java</argument>
                                        <argument>src/main/java</argument>
                                        <argument>${project.build.directory}/nrw-sources</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <sourceDirectory>${scratch.sourceDirectory}</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- only the version file is filtered: fonts and images must stay byte for byte -->
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- tests compare with AWT and ImageIO on purpose (parity); the
                                 library itself does not read java.desktop. NrwVariantTest
                                 compiles the NRW build with javax.tools -->
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.desktop,java.compiler</arg>
                                <arg>--add-reads</arg>
                                <arg>org.openpatch.scratch=java.desktop,java.compiler</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

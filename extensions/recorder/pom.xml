<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openpatch</groupId>
        <artifactId>scratch-parent</artifactId>
        <version>7.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- Records the stage as an animated GIF, on top of afterFrame.
         Uses only the core's public API (checked by all/src/build/BuildChecks.java). -->
    <artifactId>scratch-recorder</artifactId>
    <packaging>jar</packaging>
    <name>Scratch for Java: GIF recorder</name>

    <dependencies>
        <dependency>
            <groupId>org.openpatch</groupId>
            <artifactId>scratch</artifactId>
        </dependency>
        <!-- tests decode images and open sound through the desktop platform -->
        <dependency>
            <groupId>org.openpatch</groupId>
            <artifactId>scratch-desktop</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- the tests read the GIFs back with ImageIO; the extension does not -->
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.desktop</arg>
                                <arg>--add-reads</arg>
                                <arg>org.openpatch.scratch.recorder=java.desktop</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

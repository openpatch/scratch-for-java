<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openpatch</groupId>
        <artifactId>scratch-parent</artifactId>
        <version>7.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- Maps from the Tiled editor (TMX and TMJ), drawn through a layer drawer.
         Uses only the core's public API (checked by all/src/build/BuildChecks.java). -->
    <artifactId>scratch-tiled</artifactId>
    <packaging>jar</packaging>
    <name>Scratch for Java: Tiled maps</name>

    <dependencies>
        <dependency>
            <groupId>org.openpatch</groupId>
            <artifactId>scratch</artifactId>
        </dependency>
        <!-- tests decode images and open sound through the desktop platform -->
        <dependency>
            <groupId>org.openpatch</groupId>
            <artifactId>scratch-desktop</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- the tests (not the extension) run a headless game and read its
                                 draw list, which the core does not export, and draw expected
                                 tilesets with AWT -->
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.desktop</arg>
                                <arg>--add-reads</arg>
                                <arg>org.openpatch.scratch.tiled=java.desktop</arg>
                                <arg>--add-exports</arg>
                                <arg>org.openpatch.scratch/org.openpatch.scratch.internal=org.openpatch.scratch.tiled</arg>
                                <arg>--add-exports</arg>
                                <arg>org.openpatch.scratch/org.openpatch.scratch.internal.draw=org.openpatch.scratch.tiled</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED --add-modules java.desktop --add-reads org.openpatch.scratch.tiled=java.desktop</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openpatch</groupId>
        <artifactId>scratch-parent</artifactId>
        <version>7.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- Save data per user and reading/writing JSON and XML files.
         Uses only the core's public API (checked by all/src/build/BuildChecks.java). -->
    <artifactId>scratch-save</artifactId>
    <packaging>jar</packaging>
    <name>Scratch for Java: Save data and files</name>

    <dependencies>
        <dependency>
            <groupId>org.openpatch</groupId>
            <artifactId>scratch</artifactId>
        </dependency>
        <!-- tests decode images and open sound through the desktop platform -->
        <dependency>
            <groupId>org.openpatch</groupId>
            <artifactId>scratch-desktop</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
